{
  "name": "synehq-oos",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@synehq-oos/web",
    "build": "npm run build --workspace=@synehq-oos/web",
    "start": "npm run start --workspace=@synehq-oos/web",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "npm run db:generate --workspace=@synehq-oos/web",
    "db:deploy": "npm run db:deploy --workspace=@synehq-oos/web"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@types/dagre": "0.7.53",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "prettier": "3.6.2"
  }
}
